# MatrixTest 环境变量配置
# AI 配置 (支持 OpenAI / 通义千问 / Claude)
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# 设备配置
ANDROID_DEVICE_SERIAL=  # 留空自动选择
TARGET_PACKAGE=com.example.app
APP_ACTIVITY=.MainActivity

# 性能监控 Server (MatrixPerformance)
PERF_SERVER_URL=http://localhost:8000
PERF_DEVICE_ID=TEST_DEVICE_001

# CI/CD 配置
CI_TYPE=gitlab  # gitlab / github / jenkins
CI_WEBHOOK_URL=
CI_TOKEN=

# 报告配置
REPORT_TYPE=allure  # allure / html / markdown
REPORT_OUTPUT_DIR=./output/reports

# 钉钉/飞书通知
NOTIFY_TYPE=dingtalk  # dingtalk / lark / none
NOTIFY_WEBHOOK=
NOTIFY_SECRET=
